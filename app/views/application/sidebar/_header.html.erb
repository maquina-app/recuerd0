<%# locals: () %>
<%= render "components/sidebar/header" do %>
  <%= link_to workspaces_path, class: "flex items-center p-2" do %>
    <%# Full logo when sidebar is expanded. Two files, one per theme: the
        wordmark's ink is near-black, so it vanishes on the dark sidebar. %>
    <span class="group-data-[collapsible=icon]:hidden">
      <%= image_tag "recuerdo-light.svg", alt: "recuerd0", class: "h-6 dark:hidden" %>
      <%= image_tag "recuerdo-dark.svg", alt: "", aria: { hidden: true }, class: "h-6 hidden dark:block" %>
    </span>
    <%# Icon only when sidebar is collapsed to icon mode %>
    <%= image_tag "icon.svg", alt: "recuerd0", class: "h-6 hidden group-data-[collapsible=icon]:block" %>
  <% end %>
<% end %>
