<%# locals: () %>
<%= render "components/drawer/provider",
  id: "onboarding-drawer-provider",
  default_open: false,
  cookie_name: "recuerd0_onboarding_drawer_state",
  data: {
    controller: "onboarding-drawer",
    action: "toggle-group:change->onboarding-drawer#selectionChanged drawer:stateChanged->onboarding-drawer#scopeCookie",
    onboarding_drawer_toggle_group_outlet: "#onboarding-connection-methods"
  } do %>
  <%= render "components/drawer",
    id: "onboarding-drawer",
    state: :closed,
    side: :right,
    aria_label: "Connect your agent" do %>
    <%= render "components/drawer/header", show_close: false do %>
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-mono text-xs font-medium uppercase tracking-wider text-muted-foreground">Getting started</p>
          <h2 class="mt-1 font-display text-xl font-medium">Connect your agent</h2>
          <p class="mt-1 text-sm text-muted-foreground">Choose the path that matches how your agent works.</p>
        </div>
        <%= render "components/drawer/close",
          css_classes: "btn btn-ghost btn-icon-sm",
          aria: {label: "Close onboarding drawer"} do %><% end %>
      </div>
    <% end %>

    <%= render "components/drawer/content", css_classes: "space-y-5" do %>
      <%= render "components/toggle_group",
        id: "onboarding-connection-methods",
        type: :single,
        variant: :outline,
        size: :default,
        value: :terminal,
        css_classes: "w-full" do %>
        <%= render "components/toggle_group/item",
          value: :terminal,
          pressed: true,
          css_classes: "flex-1" do %>
          Terminal
        <% end %>
        <%= render "components/toggle_group/item",
          value: :chat,
          css_classes: "flex-1" do %>
          Chat
        <% end %>
      <% end %>

      <section
        class="space-y-4"
        data-onboarding-drawer-target="terminalPanel"
        data-onboarding-panel="terminal"
      >
        <div>
          <h3 class="font-medium">Connect from Terminal</h3>
          <p class="mt-1 text-sm text-muted-foreground">
            Create a full-access token in
            <%= link_to "Access Tokens",
              profile_path(anchor: "access-tokens"),
              class: "text-primary underline underline-offset-2" %>,
            then run these commands in order.
          </p>
        </div>

        <div class="space-y-2">
          <%= render "application/onboarding_command", command: "brew install maquina-app/tap/recuerd0" %>
          <%= render "application/onboarding_command", command: "recuerd0 account add personal --token <token>" %>
          <%= render "application/onboarding_command", command: "recuerd0 workspace list" %>
          <%= render "application/onboarding_command", command: "recuerd0 import propose <path> --workspace <id>" %>
          <%= render "application/onboarding_command", command: "recuerd0 import commit import.plan.yaml" %>
          <%= render "application/onboarding_command", command: "recuerd0 skills install" %>
        </div>

        <p class="text-sm text-muted-foreground">
          Import follows propose → review → commit. The commit command prompts for confirmation after you review the generated plan.
        </p>
      </section>

      <section
        class="space-y-4"
        data-onboarding-drawer-target="chatPanel"
        data-onboarding-panel="chat"
        hidden
      >
        <div>
          <h3 class="font-medium">Connect from Chat</h3>
          <p class="mt-1 text-sm text-muted-foreground">
            Add
            <%= link_to "https://recuerd0.ai/mcp",
              "https://recuerd0.ai/mcp",
              class: "font-mono text-primary underline underline-offset-2" %>
            as your MCP connector.
          </p>
        </div>

        <p class="text-sm text-muted-foreground">
          Sign in in the browser when your client opens the authorization flow. You do not need to create or paste an access token.
        </p>

        <p class="text-sm text-muted-foreground">
          MCP clients do not include the CLI installer.
          <%= link_to "Download the recuerd0 MCP skill",
            recuerd0_mcp_skill_path,
            class: "text-primary underline underline-offset-2" %>
          and add it to your client.
        </p>

        <p class="text-sm text-muted-foreground">
          Once connected, ask your agent to create your first memory so the workspace starts capturing useful context.
        </p>

        <p class="rounded-md border border-border bg-muted/40 p-3 text-sm text-muted-foreground">
          Folder imports require Terminal because they read local files.
        </p>
      </section>
    <% end %>

    <%= render "components/drawer/footer", css_classes: "flex-col items-start gap-1" do %>
      <%= link_to "Full walkthrough",
        start_path,
        class: "text-sm font-medium text-primary underline underline-offset-2" %>
      <p class="text-xs text-muted-foreground">Reopen this drawer anytime from the user menu.</p>
    <% end %>
  <% end %>
<% end %>
