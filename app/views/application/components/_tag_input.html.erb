<%# locals: (form:, field:, value: [], max_tags: nil, max_length: nil) %>
<% entry_id = "#{form.object_name}_#{field}_entry" %>

<div
  data-controller="tag-input"
  data-tag-input-field-value="<%= form.object_name %>[<%= field %>]"
  data-tag-input-max-tags-value="<%= max_tags %>"
  data-tag-input-max-length-value="<%= max_length %>"
  data-tag-input-too-many-message-value="<%= t("memories.form.tags_too_many", count: max_tags) %>"
  data-tag-input-too-long-message-value="<%= t("memories.form.tag_too_long", count: max_length) %>"
>
  <div
    class="
      tag-input-container flex flex-row flex-wrap items-center gap-2
      min-h-9 px-3 py-1 w-full min-w-0 rounded-md border border-input
      bg-transparent text-base md:text-sm outline-none
    "
  >
    <%# Existing tags %>
    <% Array(value).each do |tag| %>
      <span class="tag-badge">
        <%= icon_for(:tag) %>
        <span class="tag-label"><%= tag %></span>
        <button
          type="button"
          class="tag-x"
          data-action="click->tag-input#removeTag"
          data-tag="<%= tag %>"
          aria-label="<%= "Remove #{tag}" %>"
        >
          <%= icon_for(:x) %>
        </button>
      </span>
    <% end %>

    <%# Input for new tags %>
    <%# id is what the group's <label for=...> points at. Without it the label
        resolved to the hidden inputs below and the control people actually
        type into announced nothing but its placeholder. %>
    <input
      type="text"
      id="<%= entry_id %>"
      class="
        flex px-1 py-1 text-sm bg-transparent border-0
        placeholder:text-muted-foreground
        focus-visible:outline-none focus-visible:ring-0
        focus-visible:ring-transparent disabled:cursor-not-allowed
        disabled:opacity-50 flex-1 min-w-[120px]
      "
      placeholder="Add a tag"
      autocomplete="off"
      data-tag-input-target="input"
      data-action="keydown->tag-input#handleKeydown input->tag-input#clearError"
    >
  </div>

  <p data-form-part="error" data-tag-input-target="error" aria-live="polite" hidden></p>

  <%# Hidden inputs for form submission %>
  <div data-tag-input-target="hiddenInputs">
    <% Array(value).each do |tag| %>
      <%= form.hidden_field field, value: tag, multiple: true %>
    <% end %>
  </div>
</div>
