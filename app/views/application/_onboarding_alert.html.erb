<%# locals: () %>
<% agent_connected = onboarding_agent_connected? %>
<% first_content = onboarding_first_content? %>
<% completed_count = onboarding_completed_count %>

<%= render "components/alert",
  variant: :default,
  icon: :info,
  css_classes: "mb-4",
  data: { onboarding_banner: true } do %>
  <div
    class="flex flex-wrap items-center gap-x-3 gap-y-2"
    data-onboarding-alert-row
  >
    <p class="min-w-0 flex-1 text-sm">
      Finish setting up — connect an agent so it can read and write here.
    </p>

    <div
      class="flex shrink-0 items-center gap-1.5"
      data-onboarding-progress
      aria-label="<%= completed_count %> of <%= onboarding_total_steps %> setup steps complete"
    >
      <span
        class="size-2 rounded-full <%= agent_connected ? "bg-primary" : "bg-border" %>"
        data-onboarding-pip="agent"
        data-state="<%= agent_connected ? "complete" : "incomplete" %>"
        role="img"
        aria-label="Agent connected: <%= agent_connected ? "complete" : "incomplete" %>"
      ></span>
      <span
        class="size-2 rounded-full <%= first_content ? "bg-primary" : "bg-border" %>"
        data-onboarding-pip="content"
        data-state="<%= first_content ? "complete" : "incomplete" %>"
        role="img"
        aria-label="First content: <%= first_content ? "complete" : "incomplete" %>"
      ></span>
    </div>

    <%= render "components/drawer/trigger",
      css_classes: "shrink-0 text-[13px] font-medium text-primary hover:underline",
      data: { variant: "link", size: "sm" } do %>
      Show me how
    <% end %>

    <%= button_to "Dismiss",
      onboarding_dismiss_path,
      method: :post,
      form: {class: "contents"},
      class: "text-[13px] text-muted-foreground hover:text-foreground" %>
  </div>
<% end %>
