<%# locals: () %>
<% token_created = onboarding_token_created? %>
<% cli_connected = onboarding_cli_connected? %>
<% first_content = onboarding_first_content? %>
<% completed_count = [token_created, cli_connected, first_content].count(true) %>
<% active_step = if !token_created
  1
elsif !cli_connected
  2
elsif !first_content
  3
else
  4
end %>

<section class="mb-6" data-onboarding-banner="true">
  <div class="mb-4 flex items-center justify-between gap-4">
    <div class="flex items-baseline gap-2.5">
      <p class="font-mono text-[12px] font-medium">Getting started</p>
      <p class="text-[13px] text-muted-foreground"><%= completed_count %>/4 completed</p>
    </div>

    <%= button_to "Dismiss",
      onboarding_dismiss_path,
      method: :post,
      form: {class: "shrink-0"},
      class: "text-[13px] text-muted-foreground hover:text-foreground" %>
  </div>

  <ol class="space-y-3.5">
    <li
      class="flex items-start gap-3"
      data-onboarding-step="1"
      data-state="<%= token_created ? "complete" : "incomplete" %>"
      <% if active_step == 1 %>data-expanded="true"<% end %>
    >
      <% if token_created %>
        <span
          class="flex size-[18px] shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground"
          data-onboarding-indicator
          aria-hidden="true"
        >
          <%= icon_for(:check, class: "size-3") %>
        </span>
      <% else %>
        <span
          class="size-[18px] shrink-0 rounded-full border border-border"
          data-onboarding-indicator
          aria-hidden="true"
        ></span>
      <% end %>

      <div class="min-w-0">
        <p class="text-sm <%= active_step == 1 ? "font-medium text-foreground" : "text-muted-foreground" %>">1. Create an access token</p>
        <% if active_step == 1 %>
          <p class="mt-1 text-sm text-muted-foreground">
            <%= link_to "Access Tokens", profile_path(anchor: "access-tokens"), class: "text-primary underline underline-offset-2" %>
            — full access if your tools will write.
          </p>
        <% end %>
      </div>
    </li>

    <li
      class="flex items-start gap-3"
      data-onboarding-step="2"
      data-state="<%= cli_connected ? "complete" : "incomplete" %>"
      <% if active_step == 2 %>data-expanded="true"<% end %>
    >
      <% if cli_connected %>
        <span
          class="flex size-[18px] shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground"
          data-onboarding-indicator
          aria-hidden="true"
        >
          <%= icon_for(:check, class: "size-3") %>
        </span>
      <% else %>
        <span
          class="size-[18px] shrink-0 rounded-full border border-border"
          data-onboarding-indicator
          aria-hidden="true"
        ></span>
      <% end %>

      <div class="min-w-0">
        <p class="text-sm <%= active_step == 2 ? "font-medium text-foreground" : "text-muted-foreground" %>">2. Install the CLI and connect</p>
        <% if active_step == 2 %>
          <p class="mt-1 text-sm text-muted-foreground">
            <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[12px]">brew install maquina-app/tap/recuerd0</code>,
            then
            <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[12px]">recuerd0 account add</code>
          </p>
        <% end %>
      </div>
    </li>

    <li
      class="flex items-start gap-3"
      data-onboarding-step="3"
      data-state="<%= first_content ? "complete" : "incomplete" %>"
      <% if active_step == 3 %>data-expanded="true"<% end %>
    >
      <% if first_content %>
        <span
          class="flex size-[18px] shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground"
          data-onboarding-indicator
          aria-hidden="true"
        >
          <%= icon_for(:check, class: "size-3") %>
        </span>
      <% else %>
        <span
          class="size-[18px] shrink-0 rounded-full border border-border"
          data-onboarding-indicator
          aria-hidden="true"
        ></span>
      <% end %>

      <div class="min-w-0">
        <p class="text-sm <%= active_step == 3 ? "font-medium text-foreground" : "text-muted-foreground" %>">3. Import what you already have</p>
        <% if active_step == 3 %>
          <p class="mt-1 text-sm text-muted-foreground">
            <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[12px]">recuerd0 import propose &lt;path&gt;</code>,
            review the plan it writes, then
            <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[12px]">recuerd0 import commit</code>
          </p>
        <% end %>
      </div>
    </li>

    <li
      class="flex items-start gap-3"
      data-onboarding-step="4"
      <% if active_step == 4 %>data-expanded="true"<% end %>
    >
      <span
        class="size-[18px] shrink-0 rounded-full border border-border"
        data-onboarding-indicator
        aria-hidden="true"
      ></span>

      <div class="min-w-0">
        <p class="text-sm <%= active_step == 4 ? "font-medium text-foreground" : "text-muted-foreground" %>">4. Give your agent the skill</p>
        <% if active_step == 4 %>
          <p class="mt-1 text-sm text-muted-foreground">
            <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[12px]">recuerd0 skills install</code>,
            or the Claude Code plugin.
          </p>
        <% end %>
      </div>
    </li>
  </ol>

  <div class="mt-4 ml-[30px]">
    <%= link_to "Full walkthrough", start_path, class: "text-[13px] text-muted-foreground underline underline-offset-2 hover:text-foreground" %>
  </div>
</section>
