<%# locals: () %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<% content_for :page_title, t(".page_title") %>

<% content_for :breadcrumb do %>
  <%= responsive_breadcrumbs({ t("profiles.show.page_title") => profile_path }, t(".page_title")) %>
<% end %>

<div class="mx-auto max-w-3xl space-y-6">
  <div>
    <h1 class="font-display text-2xl font-medium leading-[1.4] tracking-tight"><%= t(".heading") %></h1>
    <p class="mt-1 text-sm text-muted-foreground"><%= t(".description") %></p>
  </div>

  <%= render "components/card" do %>
    <%= render "components/card/header" do %>
      <%= render "components/card/title", text: t("profile.ownerships.show.workspaces_title", count: @workspaces.size) %>
    <% end %>
    <%= render "components/card/content" do %>
      <% if @workspaces.any? %>
        <ul class="divide-y divide-border">
          <% @workspaces.each do |workspace| %>
            <li class="flex items-center justify-between gap-3 py-2 text-sm">
              <%= link_to workspace.name, workspace_link_path(workspace), class: "min-w-0 truncate hover:underline" %>
              <% if workspace.archived? %>
                <%= render "components/badge", variant: :secondary, size: :sm do %><%= t("profile.ownerships.show.archived") %><% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-muted-foreground"><%= t("profile.ownerships.show.no_workspaces") %></p>
      <% end %>
    <% end %>
  <% end %>

  <%= render "components/card" do %>
    <%= render "components/card/header" do %>
      <%= render "components/card/title", text: t("profile.ownerships.show.memories_title", count: @pagy.count) %>
    <% end %>
    <%= render "components/card/content" do %>
      <% if @memories.any? %>
        <ul class="divide-y divide-border">
          <% @memories.each do |memory| %>
            <li class="flex items-center justify-between gap-3 py-2 text-sm">
              <%= link_to memory.current_version.display_title, workspace_memory_path(memory.workspace, memory), class: "min-w-0 truncate hover:underline" %>
              <span class="shrink-0 text-xs text-muted-foreground"><%= memory.workspace.name %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-muted-foreground"><%= t("profile.ownerships.show.no_memories") %></p>
      <% end %>
    <% end %>
  <% end %>

  <%= pagination_nav(@pagy, :profile_ownership_path) %>
</div>
