<dialog
  id="turbo-confirm"
  class="p-0 m-0 backdrop:bg-black/80 max-w-none bg-transparent"
>
  <div class="fixed inset-0 z-50 flex items-center justify-center">
    <div
      class="
        bg-background fixed left-[50%] top-[50%] z-50 grid w-full
        max-w-[calc(100%-2rem)] translate-x-[-50%] translate-y-[-50%] gap-4 rounded-lg
        border p-6 shadow-lg duration-200 sm:max-w-[425px]
      "
    >
      <div class="flex flex-col gap-2 text-center sm:text-left">
        <h2 id="turbo-confirm-title" data-default-text="<%= t("shared.confirm.title") %>" class="font-display text-lg leading-none font-medium">
          <%= t("shared.confirm.title") %>
        </h2>
        <p id="turbo-confirm-message" class="text-muted-foreground text-sm">
          <%= t("shared.confirm.body") %>
        </p>
      </div>

      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button type="button" data-behavior="cancel" data-component="button" data-variant="outline">
          <%= t("shared.confirm.cancel") %>
        </button>
        <%# Variant and label are set per trigger: a reversible action must not %>
        <%# wear the same red as an irreversible one. %>
        <button type="button" data-behavior="confirm" data-component="button" data-variant="destructive" data-default-text="<%= t("shared.confirm.confirm") %>">
          <%= t("shared.confirm.confirm") %>
        </button>
      </div>
    </div>
  </div>
</dialog>
