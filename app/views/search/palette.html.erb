<%# The ⌘K palette's result frame. Rendered for turbo-frame requests to
    search#index, so the palette and the full results page can never disagree:
    same query, same scopes, same ordering. With JS off no frame exists, the
    form submits normally, and /search renders the full page instead. %>
<%= turbo_frame_tag SearchController::PALETTE_FRAME_ID do %>
  <% if @invalid_query %>
    <p class="palette-note" role="status">
      <%= icon_for(:alert_triangle, class: "size-3.5 shrink-0") %>
      <span><%= t("search.command.invalid_query") %></span>
    </p>
  <% elsif @suggested_workspaces || @suggested_memories %>
    <%# Opening state: what the user pinned, then what they touched last. %>
    <% if @suggested_workspaces&.any? || @suggested_memories&.any? %>
      <ul class="palette-results" role="listbox" aria-label="<%= t("search.command.suggestions_label") %>">
        <% if @suggested_workspaces&.any? %>
          <li role="presentation" class="palette-group"><%= t("search.command.pinned_workspaces") %></li>
          <% @suggested_workspaces.each do |workspace| %>
            <li role="presentation">
              <%= link_to workspace_path(workspace), role: "option", "aria-selected": "false",
                    class: "palette-item", data: {palette_result: true, turbo_frame: "_top"} do %>
                <%= icon_for(:folders, class: "size-4 shrink-0 text-muted-foreground") %>
                <span class="palette-item-label"><%= workspace.name %></span>
              <% end %>
            </li>
          <% end %>
        <% end %>

        <% if @suggested_memories&.any? %>
          <li role="presentation" class="palette-group"><%= t("search.command.jump_back_in") %></li>
          <% @suggested_memories.each do |memory| %>
            <li role="presentation">
              <%= link_to workspace_memory_path(memory.workspace, memory), role: "option", "aria-selected": "false",
                    class: "palette-item", data: {palette_result: true, turbo_frame: "_top"} do %>
                <%= icon_for(:file_text, class: "size-4 shrink-0 text-muted-foreground") %>
                <span class="palette-item-label"><%= memory.display_title %></span>
                <span class="palette-item-meta"><%= memory.workspace.name %></span>
              <% end %>
            </li>
          <% end %>
        <% end %>
      </ul>
    <% end %>
  <% elsif @query.blank? || @query.length < Searchable::MIN_QUERY_LENGTH %>
    <%# Nothing to say: the hint under the input already states the minimum. %>
  <% elsif @workspaces.any? || @memories.any? %>
    <ul class="palette-results" role="listbox" aria-label="<%= t("search.command.results_label") %>">
      <% if @workspaces.any? %>
        <li role="presentation" class="palette-group"><%= t("search.index.workspaces_heading") %></li>
        <% @workspaces.each do |workspace| %>
          <li role="presentation">
            <%= link_to workspace_path(workspace), role: "option", "aria-selected": "false",
                  class: "palette-item", data: {palette_result: true, turbo_frame: "_top"} do %>
              <%= icon_for(:folders, class: "size-4 shrink-0 text-muted-foreground") %>
              <span class="palette-item-label"><%= workspace.name %></span>
              <% if workspace.archived? %>
                <span class="palette-item-meta"><%= t("workspaces.show.archived_badge") %></span>
              <% elsif workspace.deleted? %>
                <span class="palette-item-meta"><%= t("workspaces.show.deleted_badge") %></span>
              <% end %>
            <% end %>
          </li>
        <% end %>
      <% end %>

      <% if @memories.any? %>
        <li role="presentation" class="palette-group"><%= t("search.index.memories_heading") %></li>
        <% @memories.each do |memory| %>
          <li role="presentation">
            <%= link_to workspace_memory_path(memory.workspace, memory), role: "option", "aria-selected": "false",
                  class: "palette-item", data: {palette_result: true, turbo_frame: "_top"} do %>
              <%= icon_for(:file_text, class: "size-4 shrink-0 text-muted-foreground") %>
              <span class="palette-item-label"><%= memory.display_title %></span>
              <span class="palette-item-meta"><%= memory.workspace.name %></span>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>

    <%# Enter with nothing selected falls through to the full page, which pages
        through everything the palette only shows the head of. %>
    <p class="palette-note"><%= t("search.command.see_all", count: @pagy.count) %></p>

    <%# No checkbox here — the palette stays a single input. The way back to
        withheld results is the full search page, so the link leaves the frame. %>
    <% if @obsolete_hidden_count.to_i > 0 %>
      <p class="palette-note">
        <%= icon_for(:archive, class: "size-3.5 shrink-0") %>
        <%= link_to t("search.index.obsolete_hidden_palette", count: @obsolete_hidden_count),
              search_path(q: @query, include: "obsolete"),
              data: {turbo_frame: "_top"} %>
      </p>
    <% end %>
  <% else %>
    <p class="palette-note" role="status"><%= t("search.index.no_results_title") %></p>
  <% end %>
<% end %>
