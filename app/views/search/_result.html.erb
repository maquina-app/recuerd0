<%# locals: (memory:) %>
<div>
  <p class="text-xs text-muted-foreground mb-1">
    <%= icon_for(:folders, class: "w-3 h-3 inline") %>
    <%= link_to memory.workspace.name, workspace_path(memory.workspace), class: "hover:underline" %>
    <%# Only reachable with include=inactive, where saying which
        workspace is shut down is the whole point of the result. %>
    <% if memory.workspace.archived? %>
      <span><%= t("workspaces.show.archived_badge") %></span>
    <% elsif memory.workspace.deleted? %>
      <span><%= t("workspaces.show.deleted_badge") %></span>
    <% end %>
  </p>
  <%= render "memories/memory", memory: memory, workspace: memory.workspace %>
</div>
