<%# locals: (workspace:, elsewhere_count:) %>
<%# A scoped miss is not "nothing matched": say where we looked, and when the
    rest of the account has the answer, make widening the next step. %>
<%= render "components/empty", variant: :outline do %>
  <%= render "components/empty/header" do %>
    <%= render "components/empty/media", icon: :search %>
    <%= render "components/empty/title",
          text: t("search.index.no_results_title_scoped", workspace: workspace.name, query: @query) %>
    <%= render "components/empty/description",
          text: elsewhere_count.positive? ?
            t("search.index.no_results_elsewhere", count: elsewhere_count) :
            t("search.index.no_results_nowhere") %>
  <% end %>
  <% if elsewhere_count.positive? %>
    <%= render "components/empty/content" do %>
      <%= link_to search_path(request.query_parameters.except("workspace_id", "page")),
            data: {component: "button"} do %>
        <%= icon_for(:search, class: "w-4 h-4") %>
        <%= t("search.index.scope_clear") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
