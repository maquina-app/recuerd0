<%# locals: (memory:, workspace:, show_pinned: false, pinned: nil, show_pin_badge: true, tag_scope: nil, tag_view: nil, pin_origin: nil) %>
<% display_version = memory.versioned? ? memory.current_version : memory %>
<% category_variant = { "decision" => :default, "discovery" => :secondary, "preference" => :warning, "general" => :outline }[display_version.category] || :outline %>
<%# `pinned` is the known state passed by a caller that already has it (and
    spares a per-row query); `show_pinned` is the older boolean that only ever
    forced it true. `show_pin_badge: false` suppresses the indicator on a list
    where every row is pinned by definition. %>
<% is_pinned = pinned.nil? ? (show_pinned || memory.pinned_by?(Current.user)) : pinned %>
<%# Resolved like `pinned`: the caller passes it when it already has it, and
    the partial falls back to the record when it does not. %>
<% pin_origin_value = pin_origin.nil? ? memory.pin_origin_for(Current.user) : pin_origin %>

<%# No hover:shadow-md: DESIGN.md's Flat-By-Default Rule keeps surfaces flat at
    rest and shadow_md is not in the three-item shadow vocabulary. The hover
    response is a border shift, applied in application.css. %>
<%= render "components/card", css_classes: "memory-card group" do %>
  <%= render "components/card/header" do %>
    <div class="flex items-start justify-between gap-2">
      <div class="mc-title min-w-0">
        <%= link_to display_version.display_title, workspace_memory_path(workspace, display_version) %>
      </div>

      <div class="flex flex-shrink-0 items-center gap-1.5">
        <% if workspace.active? && is_pinned && show_pin_badge %>
          <%# .pin-badge, not a bare text-primary utility: the gem's
              [data-card-part="header"] svg { color: var(--muted-foreground) }
              wins over a colour utility on the parent span, so this icon
              rendered grey everywhere until the class gave it a target. %>
          <span class="pin-badge inline-flex" title="<%= t("workspaces.show.pinned_badge") %>">
            <%= icon_for(:pin, class: "size-3.5") %>
            <span class="sr-only"><%= t("workspaces.show.pinned_badge") %></span>
          </span>
        <% end %>

        <%= render "components/dropdown_menu", auto_close: true do %>
          <%= render "components/dropdown_menu/trigger", as_child: true do %>
            <button
              type="button"
              data-component="button"
              data-variant="ghost"
              data-size="icon-sm"
              data-dropdown-menu-target="trigger"
              data-action="dropdown-menu#toggle"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label="<%= t("memories.actions.menu_label") %>"
            >
              <%= icon_for(:more_vertical, class: "size-4") %>
            </button>
          <% end %>

          <%= render "components/dropdown_menu/content", align: :end, css_classes: "w-48" do %>
            <%= render "memories/memory_actions", memory: memory, workspace: workspace, pinned: is_pinned %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="mc-meta">
      <%= render "components/badge", variant: category_variant, size: :sm do %>
        <span class="category-dot" data-cat="<%= display_version.category %>"></span>
        <%= t("memories.categories.#{display_version.category}") %>
      <% end %>

      <% if memory.versioned? %>
        <span class="mc-ind" title="<%= display_version.version_label %>">
          <%= icon_for(:git_branch) %><%= display_version.version_label %>
        </span>
      <% end %>

      <% if memory.links_count > 0 %>
        <span class="mc-ind" title="<%= pluralize(memory.links_count, "linked memory", "linked memories") %>">
          <%= icon_for(:link) %><%= memory.links_count %>
        </span>
      <% end %>

      <% if pin_origin_value == "system" %>
        <%= render "components/badge", variant: :outline, size: :sm, title: t("memories.pinned.index.system_pin_title") do %>
          <%= t("memories.pinned.index.system_pin_badge") %>
        <% end %>
      <% end %>
    </div>

    <% if display_version.source.present? %>
      <div class="mc-source">
        <%= icon_for(:file_text) %>
        <span class="min-w-0"><%= t("memories.memory.source_label") %> <span class="src-val"><%= display_version.source %></span></span>
      </div>
    <% end %>
  <% end %>

  <%= render "components/card/content" do %>
    <% plain = display_version.content&.plain_text.to_s.gsub(/\n{3,}/, "\n\n").strip %>
    <p class="excerpt-clamp"><%= truncate(plain, length: 200, omission: "...") %></p>

    <% if display_version.tags.any? %>
      <div class="flex flex-wrap gap-1.5 pt-3">
        <% display_version.tags.each do |tag| %>
          <%# A tag link leaves for one workspace's filtered view. On a
              cross-workspace list that is a silent jump, so when the caller
              names the scope the label says which workspace you land in.
              `view:` comes from a local rather than @memory_view — a shared
              partial reading a controller ivar is how it ended up always nil
              on the pinned page. %>
          <% obsolete_tag = Memory::OBSOLETE_TAGS.include?(tag.to_s.downcase) %>
          <%# The workspace list is deliberately unfiltered, so this stays a
              working filter link. Status is color *plus* icon: the swapped
              :archive glyph carries the distinction without hue alone. %>
          <%= link_to workspace_show_path(workspace, tag: tag, view: tag_view),
                class: "tag-badge",
                data: { turbo_action: "advance", obsolete: (obsolete_tag ? "true" : nil) },
                "aria-label": (tag_scope ? t("memories.actions.tag_filter_scoped_aria", workspace: tag_scope.name, tag: tag) : t("workspaces.show.toolbar.tag_filter_aria", tag: tag)) do %>
            <%= icon_for(obsolete_tag ? :archive : :tag) %>
            <span class="tag-label"><%= tag %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render "components/card/footer", align: :between do %>
    <span class="stat-chip" title="<%= t("memories.show.updated_ago", time: time_ago_in_words(memory.updated_at)) %>">
      <%= icon_for(:clock) %>
      <%= t("memories.show.updated_ago", time: time_ago_in_words(memory.updated_at)) %>
    </span>
    <%# Redundant link: same href as the card title above it, so it was a second
        tab stop and a second announcement per card for one destination — ten of
        each on a full page. Kept as a visible click affordance, removed from the
        tab order and the accessibility tree; the title link is the real one. %>
    <%= link_to workspace_memory_path(workspace, display_version),
          class: "mc-detail", tabindex: -1, "aria-hidden": true do %>
      <%= t("memories.memory.view_details") %>
      <%= icon_for(:chevron_right) %>
    <% end %>
  <% end %>
<% end %>
