<%# locals: (versions:, current_version:, workspace:) %>

<%# One query per card used to answer "is this current?" and "who wrote it?".
    versions arrives oldest first, with content and creator preloaded. %>
<div class="space-y-4">
  <% versions.reverse.each_with_index do |version, index| %>
    <% is_current = version == current_version %>
    <% previous = versions.reverse[index + 1] %>
    <div class="flex gap-4">
      <div class="flex flex-col items-center">
        <div class="w-3 h-3 rounded-full <%= is_current ? "bg-primary" : "bg-muted" %>"></div>
        <% unless index == versions.size - 1 %>
          <div class="w-px h-full min-h-[4rem] bg-border mt-2"></div>
        <% end %>
      </div>

      <%= render "components/card", css_classes: "flex-1 min-w-0 #{"ring-2 ring-primary" if is_current}" do %>
        <%= render "components/card/header" do %>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0 flex-1 space-y-1">
              <div class="flex items-center gap-2">
                <h3 class="font-display font-medium text-lg"><%= version.version_label %></h3>
                <% if is_current %>
                  <%= render "components/badge", variant: :default, css_classes: "text-xs" do %>
                    <%= t("memories.versions.index.current") %>
                  <% end %>
                <% end %>
              </div>

              <% if version.change_note.present? %>
                <p class="text-sm"><%= version.change_note %></p>
              <% end %>

              <p class="text-xs text-muted-foreground">
                <%= t("memories.versions.index.saved_by",
                      time: time_ago_in_words(version.created_at),
                      name: version.created_by&.display_name || t("ownership.account_admin")) %>
              </p>
            </div>

            <div class="flex flex-shrink-0 items-center gap-2">
              <%= link_to t("memories.versions.index.view"),
                  version_page_path(workspace, version, current: is_current),
                  data: { component: "button", variant: "ghost", size: "sm" } %>
              <% if workspace.active? && !is_current %>
                <%= button_to workspace_memory_versions_path(workspace, version),
                    method: :post,
                    data: {
                      component: "button",
                      variant: "secondary",
                      size: "sm",
                      turbo_confirm: t("memories.versions.index.restore_confirm", next: current_version.next_version_label, current: current_version.version_label),
                      confirm_severity: "warning",
                      confirm_title: t("memories.versions.index.restore_title", version: version.version_label),
                      confirm_button: t("memories.versions.index.restore_button")
                    } do %>
                  <%= icon_for(:copy_plus, class: "w-4 h-4") %>
                  <%= t("memories.versions.index.restore") %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= render "components/card/content" do %>
          <% if previous %>
            <%= render "memories/version_diff", version: version, previous: previous %>
          <% else %>
            <p class="excerpt-clamp text-sm text-muted-foreground">
              <%= truncate(version.content&.preview_text(title: version.title).to_s, length: 300, omission: "...") %>
            </p>
          <% end %>

          <% if version.tags.any? %>
            <div class="flex flex-wrap gap-1 mt-3">
              <% version.tags.each do |tag| %>
                <%= render "components/badge", variant: :outline, css_classes: "text-xs" do %>
                  <%= icon_for(:tag, class: "w-3 h-3") %>
                  <%= tag %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
