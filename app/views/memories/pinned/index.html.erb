<%# locals: () %>
<% content_for :page_title, t(".title") %>

<% content_for :breadcrumb do %>
  <%= responsive_breadcrumbs(
    {},
    t(".title"),
  ) %>
<% end %>

<div class="mx-auto max-w-6xl" data-controller="pin-focus">
  <div class="mb-6">
    <h1 class="font-display text-2xl font-medium tracking-tight"><%= t(".title") %></h1>

    <%# What the explainer used to say, said in one line that also carries the
        two facts the page never surfaced: how much of this set is here, and
        how much of the ten-pin budget is spent. The banner it replaces was a
        components/alert, which renders role="alert" — an assertive live region
        announcing a permanent, purely informational paragraph on every visit. %>
    <% if @total_count.positive? %>
      <p class="mt-1 text-sm text-muted-foreground">
        <%= if @workspace_filter
              t("memories.pinned.index.summary_filtered",
                memories: t("memories.pinned.index.summary_memories", count: @memories.size),
                workspace: @workspace_filter.name)
            else
              t("memories.pinned.index.summary",
                memories: t("memories.pinned.index.summary_memories", count: @total_count),
                projects: t("memories.pinned.index.summary_projects", count: @workspace_counts.size))
            end %>
        <span class="mx-1" aria-hidden="true">·</span>
        <%# The ten-pin cap used to be invisible here and surfaced only as a
            failed pin on some other page. Shown as a budget it becomes a
            curation prompt instead of an ambush. %>
        <span class="<%= "text-foreground font-medium" unless Current.user.can_pin_more? %>">
          <%= t(".budget", used: @pins_used, limit: @pin_budget) %>
        </span>
      </p>
    <% end %>
  </div>

  <% if @total_count.positive? %>
    <%= render "memories/pinned/toolbar",
          workspace_counts: @workspace_counts,
          active_workspace: @workspace_filter,
          sort: @sort,
          view: @view,
          total: @total_count %>
  <% end %>

  <% if @memories.any? %>
    <%# One <section> + real <h2> per workspace. The workspace used to be a
        12px muted caption floating OUTSIDE the card border, which gave it no
        owner under proximity and gave a screen reader nothing to skim: the
        whole page carried a single heading and ten anonymous <div>s. This is
        the same structure workspaces/_memories_section already uses, carried
        to the surface that needs it most because here the items come from
        different workspaces. %>
    <div class="space-y-8">
      <% @grouped.each do |workspace, memories| %>
        <% group_id = "pinned-ws-#{workspace.id}" %>
        <section aria-labelledby="<%= group_id %>">
          <div class="mb-2 flex items-center gap-2 px-0.5<%= " sr-only" if @workspace_filter %>">
            <%= icon_for(:folders, class: "size-3 shrink-0 text-muted-foreground") %>
            <h2 id="<%= group_id %>" class="ws-group-label">
              <%= link_to workspace.name, workspace_path(workspace), class: "ws-group-link" %>
            </h2>
            <span class="cat-count"><%= memories.size %></span>
            <% unless workspace.active? %>
              <%= render "components/badge", variant: :outline, size: :sm do %>
                <%= t("memories.pinned.index.workspace_inactive") %>
              <% end %>
            <% end %>
          </div>

          <% if @view == "compact" %>
            <ul class="divide-y divide-border rounded-lg border list-none">
              <% memories.each do |memory| %>
                <li>
                  <%= render "memories/memory_row", memory: memory, workspace: workspace,
                        pinned: true, show_pin_badge: false %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <ul class="grid gap-4 lg:grid-cols-2 list-none">
              <% memories.each do |memory| %>
                <li>
                  <%# show_pin_badge: false — every row on a page called Pinned
                      Memories is pinned by definition, so ten green pin icons
                      spend the accent to say nothing. pinned: true also spares
                      the per-row pinned_by? query. %>
                  <%= render "memories/memory", memory: memory, workspace: workspace,
                        pinned: true, show_pin_badge: false, tag_scope: workspace %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </section>
      <% end %>
    </div>
  <% elsif @workspace_filter %>
    <%= render "components/empty", variant: :outline do %>
      <%= render "components/empty/header" do %>
        <%= render "components/empty/media", icon: :pin %>
        <%= render "components/empty/title", text: t("memories.pinned.index.filtered_empty_title") %>
        <%= render "components/empty/description", text: t("memories.pinned.index.filtered_empty_description", workspace: @workspace_filter.name) %>
      <% end %>
      <%= render "components/empty/content" do %>
        <%= link_to t("memories.pinned.index.filtered_empty_clear"), pinned_memories_path(sort: @sort, view: @view),
              data: { component: "button", variant: "outline", size: "sm" } %>
      <% end %>
    <% end %>
  <% else %>
    <%= render "components/empty", variant: :outline do %>
      <%= render "components/empty/header" do %>
        <%= render "components/empty/media", icon: :pin %>
        <%= render "components/empty/title", text: t("memories.pinned.index.empty_title") %>
        <%# Says where the control actually is. Both the old banner and the old
            empty state told the user pins come "from any workspace"; neither
            said the control lives in a per-memory overflow menu, so a
            first-timer had to guess. %>
        <%= render "components/empty/description", text: t("memories.pinned.index.empty_description") %>
      <% end %>
      <%= render "components/empty/content" do %>
        <%= link_to workspaces_path, data: { component: "button", variant: "secondary" } do %>
          <%= icon_for(:folders, class: "w-4 h-4") %>
          <%= t("memories.pinned.index.empty_cta") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
