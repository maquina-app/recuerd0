<%# locals: (workspace:, stale_after: nil) -%>
<span class="stat-chip">
  <%= icon_for(:file_text) %>
  <strong><%= workspace.memories_count %></strong>
  <%= t("workspaces.index.memories_noun", count: workspace.memories_count) %>
</span>

<span class="stat-chip">
  <%= icon_for(:user) %>
  <%= t("ownership.created_by", name: creator_name(workspace)) %>
</span>

<% freshness = workspace_freshness(workspace, stale_after: stale_after) -%>
<span class="stat-chip <%= "is-stale" if freshness == :stale %>">
  <%= icon_for(freshness == :stale ? :alert_triangle : :clock) %>
  <% if freshness == :stale %>
    <span class="stale-flag"><%= t("workspaces.index.freshness.stale") %></span>
    <span aria-hidden="true">·</span>
  <% end %>
  <%# The exact moment is on hover, in the visitor's own time zone. %>
  <time datetime="<%= workspace.last_activity.iso8601 %>" data-controller="local-time" data-action="turbo:morph@document->local-time#render">
    <%= t("workspaces.index.activity_ago", time: time_ago_in_words(workspace.last_activity)) %>
  </time>
</span>
