<%# locals: (view_mode:, sort: nil) -%>
<%# "Mine" found nothing: offer the way back to everything, and the way to own one. %>
<%= render "components/empty", variant: :outline do %>
  <%= render "components/empty/header" do %>
    <%= render "components/empty/media", icon: :user %>
    <%= render "components/empty/title", text: t("workspaces.index.mine_empty_title") %>
    <%= render "components/empty/description", text: t("workspaces.index.mine_empty_description") %>
  <% end %>
  <%= render "components/empty/content" do %>
    <div class="flex flex-wrap items-center justify-center gap-2">
      <%= link_to workspaces_path(view: view_mode, sort: sort), data: { component: "button", variant: "outline" } do %>
        <%= t("workspaces.index.mine_empty_show_all") %>
      <% end %>
      <%= link_to new_workspace_path, data: { component: "button", variant: "default" } do %>
        <%= icon_for(:plus, class: "w-4 h-4") %>
        <%= t("workspaces.index.new_workspace") %>
      <% end %>
    </div>
  <% end %>
<% end %>
