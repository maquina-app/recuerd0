<%# locals: (items:, view_mode: "list", show_status: false, stale_after: nil) %>
<% if view_mode == "grid" %>
  <div class="ws-group-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 items-stretch">
    <%= render partial: "workspaces/workspace_card", collection: items, as: :workspace,
        locals: { show_status: show_status, stale_after: stale_after } %>
  </div>
<% else %>
  <div class="divide-y divide-border">
    <%= render partial: "workspaces/workspace", collection: items, as: :workspace,
        locals: { show_status: show_status, stale_after: stale_after } %>
  </div>
<% end %>
