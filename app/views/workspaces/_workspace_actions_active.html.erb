<%# locals: (workspace:) -%>
<% if workspace.pinned_by?(Current.user) %>
  <%= render "components/dropdown_menu/item",
      href: destroy_pin_path(pinnable_type: workspace.class.name, pinnable_id: workspace.id),
      data: { turbo_method: :delete, turbo_stream: true } do %>
    <%= icon_for(:pin, class: "w-4 h-4") %>
    <%= t("workspaces.actions.unpin") %>
  <% end %>
<% else %>
  <%# The pin budget is shared with memories and small enough to run out, so
      say how much is left before the click is rejected. %>
  <% pins_left = User::PIN_LIMIT - Current.user.pinned_items_count %>
  <%= render "components/dropdown_menu/item",
      href: create_pin_path(pinnable_type: workspace.class.name, pinnable_id: workspace.id),
      data: { turbo_method: :post, turbo_stream: true } do %>
    <%= icon_for(:pin, class: "w-4 h-4") %>
    <%= t("workspaces.actions.pin") %>
    <% if pins_left <= 3 %>
      <span class="ml-auto font-mono text-[10px] tabular-nums text-muted-foreground">
        <%= t("workspaces.actions.pins_left", count: pins_left) %>
      </span>
    <% end %>
  <% end %>
<% end %>

<%= render "components/dropdown_menu/item",
    href: edit_workspace_path(workspace) do %>
  <%= icon_for(:edit, class: "w-4 h-4") %>
  <%= t("workspaces.actions.edit") %>
<% end %>

<%= render "components/dropdown_menu/separator" %>

<%# Archive is reversible, so its confirmation is a warning, not an alarm. %>
<%= render "components/dropdown_menu/item",
    href: archive_workspace_path(workspace),
    data: {
      turbo_method: :post,
      turbo_confirm: t("workspaces.actions.confirm.archive_body"),
      confirm_severity: "warning",
      confirm_title: t("workspaces.actions.confirm.archive_title", name: workspace.name),
      confirm_button: t("workspaces.actions.confirm.archive_button")
    } do %>
  <%= icon_for(:archive, class: "w-4 h-4") %>
  <%= t("workspaces.actions.archive") %>
<% end %>

<%= render "components/dropdown_menu/item",
    href: workspace_path(workspace),
    variant: :destructive,
    data: {
      turbo_method: :delete,
      turbo_confirm: t("workspaces.actions.confirm.delete_body",
                       count: workspace.memories_count,
                       days: SoftDeletable::RETENTION_DAYS),
      confirm_severity: "destructive",
      confirm_title: t("workspaces.actions.confirm.delete_title", name: workspace.name),
      confirm_button: t("workspaces.actions.confirm.delete_button")
    } do %>
  <%= icon_for(:trash_2, class: "w-4 h-4") %>
  <%= t("workspaces.actions.delete") %>
<% end %>
