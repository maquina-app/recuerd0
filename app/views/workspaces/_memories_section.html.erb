<%# locals: (workspace:, memories:, pinned_memories:, regular_memories:, pagy:) %>
<%
  has_results = pinned_memories.any? || regular_memories.any?
  filter_active = @category.present? || @memory_query.present? || @memory_tag.present?
  search_active = @memory_query.present?
  compact = (@memory_view == "compact")
  # archived/deleted workspaces suppress pinned indicators → fold into "All"
  show_pinned_group = !search_active && workspace.active? && pinned_memories.any?

  pagination_helper = if workspace.archived?
    :archived_workspace_path
  elsif workspace.deleted?
    :deleted_workspace_path
  else
    :workspace_path
  end
%>

<% if has_results %>
  <div class="space-y-6">
    <% if search_active %>
      <section>
        <% if compact %>
          <div class="divide-y divide-border rounded-lg border">
            <%= render partial: "memories/memory_row", collection: memories, as: :memory, locals: { workspace: workspace, tag_view: @memory_view } %>
          </div>
        <% else %>
          <div class="grid gap-4 lg:grid-cols-2">
            <%= render partial: "memories/memory", collection: memories, as: :memory, locals: { workspace: workspace, tag_view: @memory_view } %>
          </div>
        <% end %>
      </section>
    <% end %>

    <% if !search_active && show_pinned_group %>
      <%# Real headings, not styled spans: this is the only structure a screen
          reader can use to skim a workspace with a hundred memories in it. %>
      <section aria-labelledby="memories-group-pinned">
        <div class="mb-2 flex items-center gap-2 px-0.5">
          <span class="text-primary"><%= icon_for(:pin, class: "size-3") %></span>
          <h2 id="memories-group-pinned" class="ws-group-label"><%= t("workspaces.show.group_pinned") %></h2>
        </div>
        <% if compact %>
          <div class="divide-y divide-border rounded-lg border">
            <%= render partial: "memories/memory_row", collection: pinned_memories, as: :memory, locals: { workspace: workspace, tag_view: @memory_view } %>
          </div>
        <% else %>
          <div class="grid gap-4 lg:grid-cols-2">
            <%= render partial: "memories/memory", collection: pinned_memories, as: :memory, locals: { workspace: workspace, show_pinned: true, tag_view: @memory_view } %>
          </div>
        <% end %>
      </section>
    <% end %>

    <% all_items = show_pinned_group ? regular_memories : (pinned_memories + regular_memories) %>
    <% if !search_active && all_items.any? %>
      <section aria-labelledby="memories-group-all">
        <div class="mb-2 px-0.5">
          <h2 id="memories-group-all" class="ws-group-label"><%= t("workspaces.show.group_all") %></h2>
        </div>
        <% if compact %>
          <div class="divide-y divide-border rounded-lg border">
            <%= render partial: "memories/memory_row", collection: all_items, as: :memory, locals: { workspace: workspace, tag_view: @memory_view } %>
          </div>
        <% else %>
          <div class="grid gap-4 lg:grid-cols-2">
            <%= render partial: "memories/memory", collection: all_items, as: :memory, locals: { workspace: workspace, tag_view: @memory_view } %>
          </div>
        <% end %>
      </section>
    <% end %>

    <div class="mt-8">
      <%= pagination_nav(pagy, pagination_helper, params: { id: workspace.id }.merge(memory_filter_params)) %>
    </div>
  </div>

<% elsif filter_active %>
  <%# Filtered-empty: a filter/search is active but nothing matched %>
  <%# Same component as the no-memories state below — two empty-state languages
      thirty lines apart taught the user that dashed vs solid meant something.
      The description names the filter that actually emptied the list. %>
  <%= render "components/empty", variant: :outline do %>
    <%= render "components/empty/header" do %>
      <%= render "components/empty/media", icon: :search %>
      <%= render "components/empty/title", text: t("workspaces.show.filtered_empty_title") %>
      <%= render "components/empty/description", text: memory_filter_summary %>
    <% end %>
    <%= render "components/empty/content" do %>
      <%= link_to t("workspaces.show.filtered_empty_clear"), workspace_show_path(workspace),
            data: { component: "button", variant: "outline", size: "sm" } %>
    <% end %>
  <% end %>

<% else %>
  <%# No memories at all in this workspace %>
  <%= render "components/empty", variant: :outline do %>
    <%= render "components/empty/header" do %>
      <%= render "components/empty/media", icon: :sticky_note %>
      <%= render "components/empty/title", text: t("workspaces.show.empty_title") %>
      <%= render "components/empty/description", text: workspace.active? ? t("workspaces.show.empty_description_active") : t("workspaces.show.empty_description_inactive") %>
    <% end %>
    <% if workspace.active? %>
      <%= render "components/empty/content" do %>
        <%= link_to new_workspace_memory_path(workspace), data: { component: "button", variant: "secondary" } do %>
          <%= icon_for(:bookmark_plus, class: "w-4 h-4") %>
          <%= t("workspaces.show.new_memory") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
