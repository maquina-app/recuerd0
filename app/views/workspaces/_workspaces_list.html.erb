<%# locals: (workspaces:, pagy:, view_mode: "list", show_pins: false, show_status: false, title: nil, path_helper: :workspaces_path, stale_after: nil) %>
<div>
  <% if show_pins %>
    <% pinned = workspaces.select { |w| w.pinned_by?(Current.user) } %>
    <% rest = workspaces - pinned %>

    <% if pinned.any? %>
      <section class="mb-6">
        <div class="mb-2 flex items-center gap-2 px-0.5">
          <%= icon_for(:pin, class: "w-3 h-3 text-primary") %>
          <h2 class="ws-group-label"><%= t("workspaces.index.pinned_label") %></h2>
        </div>
        <%= render "workspaces/workspaces_group", items: pinned, view_mode: view_mode, show_status: show_status, stale_after: stale_after %>
      </section>
    <% end %>

    <section>
      <%# With no Pinned group above it this heading distinguishes nothing, so it
          is dropped entirely rather than hidden — a heading that exists only for
          assistive tech, and only when it is meaningless, is worse than none. %>
      <% if pinned.any? %>
        <div class="mb-2 px-0.5">
          <h2 class="ws-group-label"><%= t("workspaces.index.all_workspaces_label") %></h2>
        </div>
      <% end %>
      <%= render "workspaces/workspaces_group", items: rest, view_mode: view_mode, show_status: show_status, stale_after: stale_after %>
    </section>
  <% else %>
    <section>
      <% if title %>
        <div class="mb-2 px-0.5">
          <h2 class="ws-group-label"><%= title %></h2>
        </div>
      <% end %>
      <%= render "workspaces/workspaces_group", items: workspaces, view_mode: view_mode, show_status: show_status, stale_after: stale_after %>
    </section>
  <% end %>

  <div class="mt-8">
    <%# Carry every filter/view param, or paging silently drops you back to the
        default list of everything. %>
    <%= pagination_nav(pagy, path_helper, params: { sort: params[:sort], view: params[:view], q: params[:q] }.compact_blank) %>
  </div>
</div>
