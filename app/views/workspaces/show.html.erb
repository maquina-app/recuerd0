<%# locals: () %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<% content_for :page_title, @workspace.name %>

<% content_for :breadcrumb do %>
  <%= responsive_breadcrumbs(workspace_breadcrumb_links(@workspace), @workspace.name, collapse_after: 2) %>
<% end %>

<% is_pinned = @workspace.pinned_by?(Current.user) %>
<% has_any_memories = @pinned_memories.any? || @regular_memories.any? %>
<% filter_active = @category.present? || @memory_query.present? || @memory_tag.present? %>

<div class="mx-auto max-w-5xl">
  <% if @workspace.active? && show_onboarding_alert? %>
    <%= render "application/onboarding_alert" %>
  <% end %>

  <%# ===== HEADER ===== %>
  <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex min-w-0 items-start gap-3.5">
      <%# The same recognition mark the index shows, so the tile a visitor
          clicked is the tile that greets them here. A visible Pinned badge sits
          beside the title, so the partial's sr-only marker is suppressed. %>
      <%= render "workspaces/workspace_tile", workspace: @workspace, announce_pin: false %>

      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="font-display text-2xl font-medium leading-[1.4] tracking-tight break-words"><%= @workspace.name %></h1>

          <% if @workspace.archived? %>
            <%= render "components/badge", variant: :warning, size: :sm do %>
              <%= t("workspaces.show.archived_badge") %>
            <% end %>
          <% elsif @workspace.deleted? %>
            <%= render "components/badge", variant: :outline, size: :sm do %>
              <%= t("workspaces.show.deleted_badge") %>
            <% end %>
          <% end %>

          <% if @workspace.active? && is_pinned %>
            <%= render "components/badge", variant: :secondary, size: :sm do %>
              <%= icon_for(:pin, class: "size-3") %>
              <%= t("workspaces.show.pinned_badge") %>
            <% end %>
          <% end %>
        </div>

        <% if @workspace.description.present? %>
          <p class="mt-1 text-sm text-muted-foreground break-words"><%= @workspace.description %></p>
        <% else %>
          <%# A workspace with no description cannot tell an agent what it is
              for. Say so where the description would have been, and make the
              fix one click away rather than three levels into a kebab menu. %>
          <p class="mt-1 text-sm text-muted-foreground">
            <%= t("workspaces.show.no_description") %>
            <%= link_to t("workspaces.show.add_description"), edit_workspace_path(@workspace),
                  class: "underline underline-offset-2 hover:text-foreground" %>
          </p>
        <% end %>

        <%# The ID is what this audience pastes into an MCP config or a CLI call.
            Copying it while never showing it meant you could not verify what
            landed on your clipboard, and left nothing to select by hand when
            the Clipboard API is unavailable on a plain-http install. %>
        <p class="mt-1.5 flex items-center gap-1.5 text-xs text-muted-foreground">
          <span class="sr-only"><%= t("workspaces.show.workspace_id_label") %></span>
          <code class="ws-id font-mono select-all"><%= @workspace.id %></code>
        </p>

        <%# Same two chips as the index row, from the same partial: one count,
            one freshness. The third chip here used to repeat the clock icon with
            no noun, and all three hid their exact dates in title attributes that
            no keyboard or touch user could reach. %>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5">
          <%= render "workspaces/workspace_stats", workspace: @workspace, stale_after: @stale_after %>
        </div>
      </div>
    </div>

    <div class="flex flex-shrink-0 items-center gap-1 sm:ml-auto">
      <% if @workspace.active? %>
        <%= link_to new_workspace_memory_path(@workspace), data: { component: "button", variant: "default", size: "sm" } do %>
          <%= icon_for(:bookmark_plus, class: "size-4") %>
          <%= t("workspaces.show.new_memory") %>
        <% end %>

        <div data-controller="clipboard"
             data-clipboard-text-value="<%= @workspace.id %>"
             data-clipboard-copied-text="<%= t("workspaces.show.copy_id_copied") %>"
             data-clipboard-failed-text="<%= t("workspaces.show.copy_id_failed") %>">
          <span class="sr-only" role="status" aria-live="polite" data-clipboard-target="status"></span>
          <button type="button"
                  data-component="button"
                  data-variant="ghost"
                  data-size="sm"
                  data-action="clipboard#copy"
                  aria-label="<%= t("workspaces.show.copy_id_aria") %>">
            <span data-clipboard-target="copyIcon"><%= icon_for(:copy, class: "size-4") %></span>
            <span data-clipboard-target="checkIcon" class="hidden"><%= icon_for(:check, class: "size-4") %></span>
            <%= t("workspaces.show.copy_id") %>
          </button>
        </div>

        <%= render "shared/pin_button", pinnable: @workspace %>
      <% end %>

      <%= render "components/dropdown_menu", auto_close: true do %>
        <%= render "components/dropdown_menu/trigger", as_child: true do %>
          <button
            type="button"
            data-component="button"
            data-variant="ghost"
            data-size="icon-sm"
            data-dropdown-menu-target="trigger"
            data-action="dropdown-menu#toggle"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="<%= t("workspaces.show.actions_aria") %>"
          >
            <%= icon_for(:more_vertical, class: "size-4") %>
          </button>
        <% end %>

        <%= render "components/dropdown_menu/content", align: :end, css_classes: "w-48" do %>
          <%= render "workspaces/workspace_actions", workspace: @workspace %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ===== STATE BANNERS ===== %>
  <% if @workspace.archived? %>
    <%= render "components/alert", variant: :default, icon: :archive, css_classes: "mb-5" do %>
      <%= render "components/alert/title", text: t("workspaces.show.archived_title") %>
      <%= render "components/alert/description", text: t("workspaces.show.archived_description") %>
    <% end %>
  <% elsif @workspace.deleted? %>
    <% days_left = @workspace.days_until_permanent_deletion %>
    <% deletion_text = if days_left > 0
      t("workspaces.show.deleted_description_with_days", days: pluralize(days_left, "day"))
    else
      t("workspaces.show.deleted_description_scheduled")
    end %>
    <%= render "components/alert", variant: :warning, icon: :trash_2, css_classes: "mb-5" do %>
      <div class="flex flex-wrap items-center gap-2">
        <%= render "components/alert/title", text: t("workspaces.show.deleted_title") %>
        <% if days_left == 0 %>
          <%= render "components/badge", variant: :destructive, size: :sm do %>
            <%= t("workspaces.show.deleting_today") %>
          <% end %>
        <% else %>
          <%= render "components/badge", variant: (days_left <= 7 ? :destructive : :warning), size: :sm do %>
            <%= t("workspaces.show.deletes_in", count: days_left) %>
          <% end %>
        <% end %>
      </div>
      <%= render "components/alert/description", text: deletion_text %>
    <% end %>
  <% end %>

  <div class="mb-5">
    <%= render "components/separator" %>
  </div>

  <%# ===== TOOLBAR ===== %>
  <% if has_any_memories || filter_active %>
    <%= render "workspaces/memory_toolbar", workspace: @workspace %>
  <% end %>

  <%# ===== MEMORIES ===== %>
  <%= render "workspaces/memories_section",
    workspace: @workspace,
    memories: @memories,
    pinned_memories: @pinned_memories,
    regular_memories: @regular_memories,
    pagy: @pagy %>
</div>
