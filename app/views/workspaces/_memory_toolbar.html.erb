<%# locals: (workspace:) %>
<div class="mb-6 flex flex-col gap-3">
  <%# Category filter chips — own horizontal scroll, never widens the page %>
  <div class="category-bar" role="group" aria-label="<%= t("workspaces.show.toolbar.filter_label") %>">
    <%# While a tag governs the list, no category is selected — showing "All" lit
        would claim the list is unfiltered when it plainly is not. Clicking any
        category from here replaces the tag filter. %>
    <% all_active = @category.nil? && @memory_tag.blank? %>
    <%= link_to workspace_show_path(workspace, **memory_filter_params(category: nil, tag: nil)),
          class: "category-chip",
          data: { state: (all_active ? "on" : "off") },
          "aria-current": (all_active ? "true" : nil) do %>
      <span><%= t("workspaces.show.toolbar.category_all") %></span>
      <span class="cat-count"><%= @category_counts.values.sum %></span>
    <% end %>

    <% Memory::CATEGORIES.each do |cat| %>
      <% active = (@category == cat) %>
      <%= link_to workspace_show_path(workspace, **memory_filter_params(category: cat, tag: nil)),
            class: "category-chip",
            data: { state: (active ? "on" : "off") },
            "aria-current": (active ? "true" : nil) do %>
        <span class="category-dot" data-cat="<%= cat %>"></span>
        <span><%= t("memories.categories.#{cat}") %></span>
        <span class="cat-count"><%= @category_counts[cat] %></span>
      <% end %>
    <% end %>
  </div>

  <%# Controls: within-workspace search · sort · view density %>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <%# Same accelerators as the workspaces-list filter: "/" focuses, Esc clears,
        typing submits debounced. turbo_action is "replace", not "advance", so a
        keystroke burst does not push one history entry per submit and so the
        morph (see the layout's turbo-refresh-method meta) can preserve focus and
        caret while the list re-renders under the cursor. %>
    <%= form_with url: workspace_show_path(workspace), method: :get, class: "search-field w-full sm:max-w-xs", data: { controller: "ws-filter", turbo_action: "replace", ws_filter_target: "form" } do %>
      <%= icon_for(:search) %>
      <label for="memory-toolbar-search" class="sr-only"><%= t("workspaces.show.toolbar.search_label") %></label>
      <input
        id="memory-toolbar-search"
        type="search"
        name="q"
        value="<%= @memory_query %>"
        data-component="input"
        placeholder="<%= t("workspaces.show.toolbar.search_placeholder") %>"
        autocomplete="off"
        data-ws-filter-target="input"
        data-action="input->ws-filter#submit search->ws-filter#submit keydown.esc->ws-filter#clear"
      >
      <% if @category.present? %><input type="hidden" name="category" value="<%= @category %>"><% end %>
      <% if @memory_sort_param.present? %><input type="hidden" name="sort" value="<%= @memory_sort_param %>"><% end %>
      <% if @memory_view.present? %><input type="hidden" name="view" value="<%= @memory_view %>"><% end %>
      <kbd aria-hidden="true">/</kbd>
    <% end %>

    <div class="flex items-center gap-2">
      <%# Sort segmented control %>
      <div class="seg" role="group" aria-label="<%= t("workspaces.show.toolbar.sort_label") %>">
        <% if @memory_query.present? %>
          <%= link_to t("workspaces.show.toolbar.sort_relevance"), workspace_show_path(workspace, **memory_filter_params(sort: "relevance")),
                class: "seg-item",
                data: { state: (@memory_sort == "relevance" ? "on" : "off") },
                "aria-current": (@memory_sort == "relevance" ? "true" : nil) %>
        <% end %>
        <%= link_to t("workspaces.show.toolbar.sort_updated"), workspace_show_path(workspace, **memory_filter_params(sort: "updated")),
              class: "seg-item",
              data: { state: (@memory_sort == "updated" ? "on" : "off") },
              "aria-current": (@memory_sort == "updated" ? "true" : nil) %>
        <%= link_to t("workspaces.show.toolbar.sort_created"), workspace_show_path(workspace, **memory_filter_params(sort: "created")),
              class: "seg-item",
              data: { state: (@memory_sort == "created" ? "on" : "off") },
              "aria-current": (@memory_sort == "created" ? "true" : nil) %>
        <%= link_to t("workspaces.show.toolbar.sort_title"), workspace_show_path(workspace, **memory_filter_params(sort: "title")),
              class: "seg-item",
              data: { state: (@memory_sort == "title" ? "on" : "off") },
              "aria-current": (@memory_sort == "title" ? "true" : nil) %>
      </div>

      <%# View density segmented control %>
      <div class="seg" role="group" aria-label="<%= t("workspaces.show.toolbar.view_label") %>">
        <%= link_to workspace_show_path(workspace, **memory_filter_params(view: "cards")),
              class: "seg-item seg-item-icon",
              data: { state: (@memory_view == "compact" ? "off" : "on") },
              "aria-current": (@memory_view == "compact" ? nil : "true"),
              "aria-label": t("workspaces.show.toolbar.view_cards"),
              title: t("workspaces.show.toolbar.view_cards") do %>
          <%= icon_for(:grid) %>
        <% end %>
        <%= link_to workspace_show_path(workspace, **memory_filter_params(view: "compact")),
              class: "seg-item seg-item-icon",
              data: { state: (@memory_view == "compact" ? "on" : "off") },
              "aria-current": (@memory_view == "compact" ? "true" : nil),
              "aria-label": t("workspaces.show.toolbar.view_compact"),
              title: t("workspaces.show.toolbar.view_compact") do %>
          <%= icon_for(:list) %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @memory_tag.present? %>
    <%# An applied filter is state, not an option — so it must not wear the same
        pill as the category toggles above, and must not spend the accent. It
        sits last in the toolbar, directly above the list it narrows, and the
        whole token is the button that removes it. %>
    <p class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
      <span><%= t("workspaces.show.toolbar.tag_filter_prefix") %></span>
      <%= link_to workspace_show_path(workspace, view: @memory_view),
            class: "filter-token",
            data: { turbo_action: "advance" },
            "aria-label": t("workspaces.show.toolbar.tag_filter_remove", tag: @memory_tag) do %>
        <%= icon_for(:tag) %>
        <span class="filter-token-value"><%= @memory_tag %></span>
        <span class="filter-token-x" aria-hidden="true"><%= icon_for(:x) %></span>
      <% end %>
    </p>
  <% end %>

  <% if @memory_query.present? && @memory_query.length < Searchable::MIN_QUERY_LENGTH %>
    <p class="text-xs text-muted-foreground"><%= t("workspaces.show.toolbar.short_query_hint") %></p>
  <% end %>
</div>
