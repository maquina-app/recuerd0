<% content_for :title, "#{t('invitations.show.page_title', account: @account.invitation_name)} — recuerd0" %>

<div>
  <%= render "components/card" do %>
    <%= render "components/card/header", css_classes: "text-center" do %>
      <%= render "components/card/title", text: t("invitations.show.heading", account: @account.invitation_name) %>
      <%= render "components/card/description", text: t("invitations.show.description") %>
    <% end %>

    <%= render "components/card/content" do %>
      <% if Current.user && @user.errors.empty? %>
        <%= render "components/alert", variant: :default, icon: :info, css_classes: "mb-4" do %>
          <p><%= t("invitations.show.signed_in", email: Current.user.email_address) %></p>
        <% end %>
      <% end %>

      <%= form_with(model: @user, url: invitations_path, data: { component: "form" }) do |form| %>
        <%= form.hidden_field :token, value: @token, name: "token" %>

        <div data-form-part="group">
          <%= form.label :email_address, t("invitations.show.email_label"), data: { component: "label" } %>
          <%= form.email_field :email_address, required: true, autofocus: true,
              aria: field_error_aria(form, :email_address),
              autocomplete: "email", placeholder: t("invitations.show.email_placeholder"),
              data: { component: "input" } %>
          <% if @user.errors.where(:email_address, :taken).any? %>
            <p data-form-part="error" id="<%= form.field_id(:email_address, :error) %>">
              <%= t("invitations.show.email_taken") %>
              <%= link_to t("invitations.show.sign_in_instead"), new_session_path, class: "underline underline-offset-2" %>
            </p>
          <% elsif @user.errors[:email_address].any? %>
            <p data-form-part="error" id="<%= form.field_id(:email_address, :error) %>"><%= @user.errors[:email_address].first %></p>
          <% end %>
        </div>

        <div data-form-part="group">
          <%= form.label :password, data: { component: "label" } %>
          <%= form.password_field :password, required: true,
              aria: field_error_aria(form, :password),
              autocomplete: "new-password", placeholder: t("invitations.show.password_placeholder"),
              data: { component: "input" } %>
          <% if @user.errors[:password].any? %>
            <p data-form-part="error" id="<%= form.field_id(:password, :error) %>"><%= @user.errors[:password].first %></p>
          <% end %>
        </div>

        <div data-form-part="group">
          <%= form.label :password_confirmation, t("invitations.show.password_confirmation_label"), data: { component: "label" } %>
          <%= form.password_field :password_confirmation, required: true,
              aria: field_error_aria(form, :password_confirmation),
              autocomplete: "new-password", placeholder: t("invitations.show.password_confirmation_placeholder"),
              data: { component: "input" } %>
          <% if @user.errors[:password_confirmation].any? %>
            <p data-form-part="error" id="<%= form.field_id(:password_confirmation, :error) %>"><%= @user.errors[:password_confirmation].first %></p>
          <% end %>
        </div>

        <div data-form-part="actions">
          <%= form.submit t("invitations.show.submit"),
              data: { component: "button", variant: "primary" }, class: "w-full" %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if multi_tenant? %>
    <div class="text-center text-xs text-muted-foreground mt-4">
      <%= t("invitations.show.legal_prefix") %>
      <%= link_to t("invitations.show.legal_terms"), terms_path, class: "underline underline-offset-4 hover:text-primary" %>
      <%= t("invitations.show.legal_and") %>
      <%= link_to t("invitations.show.legal_privacy"), privacy_path, class: "underline underline-offset-4 hover:text-primary" %>.
    </div>
  <% end %>

  <div class="text-center mt-6">
    <%= link_to new_session_path, class: "inline-flex items-center gap-1 text-sm underline underline-offset-4 hover:text-primary" do %>
      <%= icon_for :arrow_left, class: "size-4" %> <%= t("invitations.show.back_to_sign_in") %>
    <% end %>
  </div>
</div>
